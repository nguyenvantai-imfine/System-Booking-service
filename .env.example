# ==============================================================================
# HỆ THỐNG SYSTEM-BOOKING-SERVICE - BIẾN MÔI TRƯỜNG TỔNG THỂ (.env)
# ==============================================================================

# 1. Cấu hình Microsoft SQL Server (Container: sqlserver)
SA_PASSWORD=Password123!
MSSQL_PORT=1433

# 2. Cấu hình Hotel Service (Container: hotel-service)
HOTEL_SERVICE_PORT=8000
APP_NAME=Hotel Service
API_V1_STR=/api/v1

# 3. Cấu hình User Service (Container: user-service)
USER_SERVICE_PORT=8001
USER_DB_NAME=user_service

# 4. Cấu hình Room Service (Container: room-service)
ROOM_SERVICE_PORT=8002
ROOM_DB_NAME=room_service

# 5. Cấu hình Booking Service (Container: booking-service)
BOOKING_SERVICE_PORT=8003
BOOKING_DB_NAME=booking_service
HOLD_EXPIRE_MINUTES=15

# 6. Cấu hình Payment Service (Container: payment-service)
PAYMENT_SERVICE_PORT=8004
PAYMENT_DB_NAME=payment_service

# 7. Cấu hình Notification Service (Container: notification-service)
NOTIFICATION_SERVICE_PORT=8005
NOTIFICATION_DB_NAME=notification_service

# 8. Cấu hình API Gateway (Container: api-gateway)
GATEWAY_PORT=8080

# 9. Cấu hình RabbitMQ Message Broker
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# 10. Cấu hình JWT Dùng Chung (Microservices SSO)
JWT_SECRET_KEY=booking_super_secret_jwt_key_2026_xyz!@#
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# 6. Cấu hình kết nối Database cho Microservices trong Docker
DB_SERVER=sqlserver
DB_PORT=1433
DB_NAME=hotel_service
DB_USER=sa
DB_PASSWORD=Password123!
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUSTED_CONNECTION=False

# 11. Cấu hình CORS Allowed Origins (phân tách bằng dấu phẩy)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# 12. Xác thực nội bộ giữa các microservices (Server-to-Server Internal Secret)
INTERNAL_SERVICE_SECRET=booking_internal_secret_key_2026

# 13. Cấu hình gửi Email SMTP (Notification Service)
USE_MOCK_EMAIL=True
MOCK_EMAIL_SEND=True
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=True
SMTP_FROM_EMAIL=no-reply@hotelbooking.com
SMTP_FROM_NAME=Hệ Thống Đặt Phòng Khách Sạn
