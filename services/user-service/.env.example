# ==============================================================================
# USER SERVICE ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

APP_NAME="User Service"
API_V1_STR="/api/v1"
PORT=8001

# Cấu hình bảo mật JWT
JWT_SECRET_KEY="booking_super_secret_jwt_key_2026_xyz!@#"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cấu hình SQL Server Database
# Local Windows SQLEXPRESS (mặc định):
DB_SERVER=localhost\SQLEXPRESS
DB_PORT=0
DB_NAME=user_service
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUSTED_CONNECTION=True

# Docker / Production SQL Server:
# DB_SERVER=sqlserver
# DB_PORT=1433
# DB_USER=sa
# DB_PASSWORD=Password123!
# DB_TRUSTED_CONNECTION=False

# Cấu hình CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
