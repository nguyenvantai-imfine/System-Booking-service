APP_NAME=Notification Service
PORT=8005
API_V1_STR=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Must match the JWT issuer (User Service) and other JWT-verifying services.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256

# Must match Booking, Payment, and Room service configuration.
INTERNAL_SERVICE_SECRET=
TRUSTED_INTERNAL_CIDRS=127.0.0.1/32,::1/128

# Local Windows SQL Server. Use DB_TRUSTED_CONNECTION=False and set DB_USER/DB_PASSWORD
# only when using SQL Server Authentication.
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=notification_service
DB_USER=sa
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUSTED_CONNECTION=True

# Start RabbitMQ separately before integration testing.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_ENABLED=True

# Keep mock enabled for local tests; this does not send real email.
MOCK_EMAIL_SEND=True
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=True
SMTP_FROM_EMAIL=no-reply@hotelbooking.com
SMTP_FROM_NAME=Hotel Booking
