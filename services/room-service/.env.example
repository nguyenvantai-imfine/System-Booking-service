APP_NAME=Room Service
PORT=8002
API_V1_STR=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Local Windows SQL Server. Use DB_TRUSTED_CONNECTION=False and set DB_USER/DB_PASSWORD
# only when using SQL Server Authentication.
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=room_service
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUSTED_CONNECTION=True
DB_USER=sa
DB_PASSWORD=

# Must match User, Hotel, Booking, Payment, and Notification service configuration.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256

# Local service URLs (do not use Docker service names when running on Windows).
HOTEL_SERVICE_URL=http://localhost:8000/api/v1
BOOKING_SERVICE_URL=http://localhost:8003/api/v1
BOOKING_SERVICE_TIMEOUT=2

# Must match Booking, Payment, and Notification service configuration.
INTERNAL_SERVICE_SECRET=
