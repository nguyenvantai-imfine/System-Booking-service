# ==========================================
# CẤU HÌNH DATABASE SQL SERVER (room-service)
# ==========================================
DB_SERVER=sqlserver
DB_PORT=1433
DB_NAME=room_service
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUSTED_CONNECTION=False
DB_USER=sa
DB_PASSWORD=Password123!

# Cấu hình App & Port
PORT=8002
APP_NAME=Room Service
API_V1_STR=/api/v1

# Cấu hình JWT Auth Dùng Chung
JWT_SECRET_KEY=booking_super_secret_jwt_key_2026_xyz!@#
JWT_ALGORITHM=HS256

# Cấu hình CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Microservices URLs
HOTEL_SERVICE_URL=http://hotel-service:8000/api/v1
BOOKING_SERVICE_URL=http://booking-service:8003/api/v1
