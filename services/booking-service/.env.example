# ==========================================
# CẤU HÌNH DATABASE SQL SERVER (booking-service)
# ==========================================
DB_SERVER=sqlserver
DB_PORT=1433
DB_NAME=booking_service
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUSTED_CONNECTION=False
DB_USER=sa
DB_PASSWORD=Password123!

# Cấu hình App & Port
PORT=8003
APP_NAME=Booking Service
API_V1_STR=/api/v1

# Cấu hình JWT Auth Dùng Chung
JWT_SECRET_KEY=booking_super_secret_jwt_key_2026_xyz!@#
JWT_ALGORITHM=HS256

HOLD_MINUTES=15

# Cấu hình CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Microservices URLs
ROOM_SERVICE_URL=http://room-service:8002/api/v1
PAYMENT_SERVICE_URL=http://payment-service:8004/api/v1
NOTIFICATION_SERVICE_URL=http://notification-service:8005/api/v1
INTERNAL_SERVICE_SECRET=booking_internal_secret_key_2026
