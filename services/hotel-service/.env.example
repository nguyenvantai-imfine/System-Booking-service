# ==============================================================================
# HOTEL SERVICE ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# 1. Cấu hình ứng dụng
APP_NAME=Hotel Service
API_V1_STR=/api/v1

# 2. Cấu hình kết nối SQL Server
# - Khi chạy qua Docker Compose: DB_SERVER=sqlserver, DB_PORT=1433
# - Khi chạy trực tiếp trên máy host (Local): DB_SERVER=localhost\SQLEXPRESS, DB_PORT=0
DB_SERVER=sqlserver
DB_PORT=1433
DB_NAME=hotel_service
DB_DRIVER=ODBC Driver 18 for SQL Server

# [CẤU HÌNH DOCKER HOẶC SQL SERVER AUTHENTICATION]
DB_USER=sa
DB_PASSWORD=Password123!
DB_TRUSTED_CONNECTION=False

# [CẤU HÌNH LOCAL WINDOWS AUTHENTICATION (SQLEXPRESS)]
# Nếu chạy trực tiếp trên Windows và SQL Server dùng Windows Auth:
# DB_SERVER=localhost\SQLEXPRESS
# DB_PORT=0
# DB_TRUSTED_CONNECTION=True