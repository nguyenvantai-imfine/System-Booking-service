# ==============================================================================
# HOTEL SERVICE LOCAL ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# 1. Cấu hình ứng dụng
APP_NAME=Hotel Service
API_V1_STR=/api/v1

# 2. Cấu hình kết nối SQL Server
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=hotel_service
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUSTED_CONNECTION=True
DB_USER=sa
DB_PASSWORD=

# Must match User Service and JWT-verifying services.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256

# 3. Cấu hình CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001